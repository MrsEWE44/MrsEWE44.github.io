<h1 class="page-title">标签</h1>
<ul class="tag-cloud">
  <% site.tags.map(function (tag) { return tag; }).sort(function (a, b) { return b.length - a.length; }).forEach(function (tag) { %>
    <% if (tag.length) { %>
      <li class="tag-cloud-item">
        <a href="<%- url_for(tag.path) %>">#<%= tag.name %> <span class="count"><%= tag.length %></span></a>
      </li>
    <% } %>
  <% }); %>
</ul>